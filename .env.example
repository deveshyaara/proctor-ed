# Use the DIRECT (non-pooled) Neon connection string here.
# Neon's pooler (PgBouncer transaction mode) breaks Prisma interactive transactions.
# directUrl in schema.prisma only applies to the Prisma CLI, NOT PrismaClient at runtime.
# For Neon: remove "-pooler" from the hostname to get the direct endpoint.
DATABASE_URL="postgresql://postgres:password@localhost:5432/proctor_ed"

# Neon Auth (Managed Better Auth)
NEON_AUTH_BASE_URL="https://your-neon-auth-url.neon.tech"
NEON_AUTH_COOKIE_SECRET="your-cookie-secret-at-least-32-characters-long"
# Optional JWKS endpoint
NEON_AUTH_JWKS_URL="https://your-neon-auth-url.neon.tech/.well-known/jwks.json"

# Legacy Auth.js secret (kept temporarily during transition)
AUTH_SECRET="your-auth-secret-here-generate-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"

# Storage provider: "local" for development, "s3" for production
STORAGE_PROVIDER="local"

# S3-compatible storage (required when STORAGE_PROVIDER=s3)
STORAGE_ENDPOINT=""
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""
STORAGE_BUCKET=""
STORAGE_REGION="auto"

# App URL (used for generating links)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Development seed password (do NOT use in production)
SEED_TEACHER_PASSWORD="teacher123"
