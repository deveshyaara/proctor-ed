{
  "name": "proctor-ed-mcp-server",
  "version": "1.0.0",
  "description": "Production-ready MCP server for ProctorED AI exam paper generation",
  "type": "module",
  "bin": {
    "proctor-ed-mcp": "./dist/index.js"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "dev:http": "cross-env MCP_TRANSPORT=http tsx src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "start:http": "cross-env MCP_TRANSPORT=http node dist/index.js",
    "start:render": "tsc && cross-env MCP_TRANSPORT=http node dist/index.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:unit": "node --experimental-vm-modules node_modules/jest/bin/jest.js tests/unit",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.3",
    "dotenv": "^16.4.7",
    "zod": "^3.24.0",
    "zod-to-json-schema": "^3.23.5"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^22.0.0",
    "cross-env": "^7.0.3",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.14",
    "tsx": "^4.23.13",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
