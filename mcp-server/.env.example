# ── ProctorED API ─────────────────────────────────────────────────────────────
# Base URL of your ProctorED instance (no trailing slash)
PROCTOR_ED_API_URL=http://localhost:3000

# Long-lived service token generated from POST /api/auth/mcp-tokens
# For local dev: generate with `npm run auth:bind-neon-user` then create a token
PROCTOR_ED_SERVICE_TOKEN=

# ── OpenAI ───────────────────────────────────────────────────────────────────
OPENAI_API_KEY=

# Model to use for generation (structured output required)
OPENAI_MODEL=gpt-4o-2024-08-06

# Model to use for answer verification (can be same or cheaper)
OPENAI_VERIFIER_MODEL=gpt-4o-mini-2024-07-18

# ── MCP Server ───────────────────────────────────────────────────────────────
# Transport: "stdio" (default) or "http"
MCP_TRANSPORT=stdio

# HTTP transport port (only used when MCP_TRANSPORT=http)
MCP_HTTP_PORT=3001

# Shared secret for HTTP transport bearer auth
MCP_AUTH_SECRET=

# ── Generation ───────────────────────────────────────────────────────────────
# Max questions per LLM batch
BATCH_SIZE=5

# Max regeneration attempts per rejected question
MAX_RETRIES_PER_QUESTION=3

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=info
